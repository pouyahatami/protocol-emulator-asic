[tasks]
prove
cover

[options]
prove: mode prove
cover: mode cover
depth 20

[engines]
smtbmc boolector

[script]
# yosys-slang reads the concurrent SVA that read_verilog rejects
plugin -i slang
read_slang pio_sm_ctrl.sv pio_sm_ctrl_formal.sv --top pio_sm_ctrl_formal
prep -top pio_sm_ctrl_formal

